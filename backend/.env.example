# 데이터베이스 설정
DATABASE_URL=postgresql://xmanager:xbeamtech@localhost:5432/xmanager?client_encoding=utf8

# 보안 설정 (운영환경에서는 반드시 변경하세요!)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 파일 업로드 설정
# 프로젝트 루트 기준 상대 경로 (코드/데이터 분리)
STORAGE_PATH=../storage
# 50MB (52428800 bytes)
MAX_UPLOAD_SIZE=52428800

# 페이지네이션
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
